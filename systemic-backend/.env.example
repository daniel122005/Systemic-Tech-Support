# Copia este archivo como ".env" y llena los valores. El archivo .env NUNCA se sube a GitHub.

# Conexión a la base con el usuario LIMITADO st_backend (no uses postgres aquí).
# Formato (Session pooler de Supabase):
#   postgresql://st_backend.REF_DEL_PROYECTO:CONTRASEÑA@aws-0-us-east-2.pooler.supabase.com:5432/postgres
# Si la contraseña tiene símbolos como @ # / ? cámbiala por una solo de letras y números.
DATABASE_URL=postgresql://st_backend.fwscfaxsashkottfwwcl:PON_AQUI_LA_CONTRASEÑA_DE_ST_BACKEND@aws-0-us-east-2.pooler.supabase.com:5432/postgres

# Supabase > Project Settings > API (o botón Connect > API Keys)
SUPABASE_URL=https://fwscfaxsashkottfwwcl.supabase.co
# La clave "anon" / "publishable" (es pública). NUNCA pongas aquí la service_role / secret.
SUPABASE_ANON_KEY=PON_AQUI_LA_CLAVE_ANON

# Puerto del backend y dirección del frontend que podrá llamarlo
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development
